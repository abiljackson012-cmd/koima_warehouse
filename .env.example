# Осы файлды .env деп көшіріп, мәндерін толтырыңыз. .env GitHub-қа жүктелмейді.
SECRET_KEY=ұзын-кездейсоқ-мән-ең-кемі-32-таңба

# Дерекқор: әдепкіде SQLite файлы. PostgreSQL (Neon/Supabase/Railway) үшін келесі жолды ашыңыз:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Бастапқы аккаунттар (бірінші іске қосуда жасалады)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=өз-құпиясөзіңізді-жазыңыз
MANAGER_USERNAME=manager
MANAGER_EMAIL=manager@example.com
MANAGER_PASSWORD=өз-құпиясөзіңізді-жазыңыз

# 1 болса, бос базаға 5 демо-тауар қосылады
SEED_DEMO_DATA=1

TOKEN_HOURS=8
# HTTPS-те (хостингте) 1 деп қойыңыз
COOKIE_SECURE=0
LOG_LEVEL=INFO
